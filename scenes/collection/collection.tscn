[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/collection.gd" id="1_collection"]

[node name="Collection" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_collection")

[node name="MarginContainer" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 48
theme_override_constants/margin_top = 48
theme_override_constants/margin_right = 48
theme_override_constants/margin_bottom = 48

[node name="VBoxContainer" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2
alignment = 1

[node name="TitleLabel" type="Label" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
text = "Collection"
horizontal_alignment = 1

[node name="StillTitle" type="Label" parent="MarginContainer/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
text = "First Memory"
horizontal_alignment = 1

[node name="ProgressLabel" type="Label" parent="MarginContainer/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
text = "Restoration: 0%"
horizontal_alignment = 1

[node name="StatusLabel" type="Label" parent="MarginContainer/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
text = "Locked / In Progress"
horizontal_alignment = 1

[node name="StageSelectButton" type="Button" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
text = "STAGE SELECT"

[node name="TitleButton" type="Button" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
text = "TITLE"

[connection signal="pressed" from="MarginContainer/VBoxContainer/StageSelectButton" to="." method="_on_stage_select_pressed"]
[connection signal="pressed" from="MarginContainer/VBoxContainer/TitleButton" to="." method="_on_title_pressed"]
