[node name="BackButton" type="Button" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
text = "BACK"

[connection signal="pressed" from="MarginContainer/VBoxContainer/Stage1Button" to="." method="_on_stage_1_pressed"]
[connection signal="pressed" from="MarginContainer/VBoxContainer/Stage2Button" to="." method="_on_stage_2_pressed"]
