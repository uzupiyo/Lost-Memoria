[node name="Stage3Button" type="Button" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
text = "Stage 3"

[node name="Stage4Button" type="Button" parent="MarginContainer/VBoxContainer"]
layout_mode = 2
