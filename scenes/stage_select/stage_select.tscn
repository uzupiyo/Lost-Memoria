[connection signal="pressed" from="MarginContainer/VBoxContainer/Stage4Button" to="." method="_on_stage_4_pressed"]
[connection signal="pressed" from="MarginContainer/VBoxContainer/BackButton" to="." method="_on_back_pressed"]
